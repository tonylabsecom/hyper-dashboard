{
  "cleanUrls": true,
  "headers": [
    { "source": "/data/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-store, max-age=0" }, { "key": "Access-Control-Allow-Origin", "value": "*" } ] },
    { "source": "/(config.js|app.js|style.css|index.html)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] }
  ]
}
